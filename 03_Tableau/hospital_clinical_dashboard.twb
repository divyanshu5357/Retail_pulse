<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.1.0 (20241.24.0115.1114)' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AccessibleZoneTabOrder />
    <AutoCreateAndUpdateDBCrossFilterAction />
    <MapboxVectorStylesAndLayers />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <style-theme name='smooth' />
  <datasources>
    <datasource caption='PulseCare_Hospital_Clinical_Data' inline='true' name='federated.hospital_data' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='hospital_master' name='textscan.hospital_conn'>
            <connection class='textscan' directory='.' filename='hospital_clinical_master.csv' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.hospital_conn' name='hospital_clinical_master#csv' table='[hospital_clinical_master#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US'>
            <column datatype='integer' name='billing_id' ordinal='0' />
            <column datatype='integer' name='admission_id' ordinal='1' />
            <column datatype='date' name='admission_date' ordinal='2' />
            <column datatype='integer' name='admission_year' ordinal='3' />
            <column datatype='integer' name='admission_month' ordinal='4' />
            <column datatype='string' name='admission_month_name' ordinal='5' />
            <column datatype='string' name='admission_year_month' ordinal='6' />
            <column datatype='date' name='discharge_date' ordinal='7' />
            <column datatype='integer' name='length_of_stay' ordinal='8' />
            <column datatype='string' name='admission_type' ordinal='9' />
            <column datatype='string' name='admission_status' ordinal='10' />
            <column datatype='string' name='triage_level' ordinal='11' />
            <column datatype='integer' name='patient_id' ordinal='12' />
            <column datatype='string' name='patient_name' ordinal='13' />
            <column datatype='integer' name='age' ordinal='14' />
            <column datatype='string' name='gender' ordinal='15' />
            <column datatype='string' name='blood_group' ordinal='16' />
            <column datatype='string' name='city' ordinal='17' />
            <column datatype='string' name='region' ordinal='18' />
            <column datatype='string' name='insurance_plan' ordinal='19' />
            <column datatype='integer' name='department_id' ordinal='20' />
            <column datatype='string' name='department_name' ordinal='21' />
            <column datatype='string' name='assigned_ward' ordinal='22' />
            <column datatype='string' name='procedure_name' ordinal='23' />
            <column datatype='real' name='procedure_cost' ordinal='24' />
            <column datatype='real' name='medication_cost' ordinal='25' />
            <column datatype='real' name='doctor_fee' ordinal='26' />
            <column datatype='real' name='room_charges' ordinal='27' />
            <column datatype='real' name='discount_percent' ordinal='28' />
            <column datatype='real' name='gross_amount' ordinal='29' />
            <column datatype='real' name='discount_amount' ordinal='30' />
            <column datatype='real' name='net_amount' ordinal='31' />
            <column datatype='real' name='insurance_covered' ordinal='32' />
            <column datatype='real' name='patient_payable' ordinal='33' />
          </columns>
        </relation>
        <metadata-records>
          <metadata-record class='column'>
            <remote-name>billing_id</remote-name>
            <remote-type>20</remote-type>
            <local-name>[billing_id]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>billing_id</remote-alias>
            <ordinal>0</ordinal>
            <local-type>integer</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>admission_date</remote-name>
            <remote-type>133</remote-type>
            <local-name>[admission_date]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>admission_date</remote-alias>
            <ordinal>2</ordinal>
            <local-type>date</local-type>
            <aggregation>Year</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>department_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[department_name]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>department_name</remote-alias>
            <ordinal>21</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>triage_level</remote-name>
            <remote-type>129</remote-type>
            <local-name>[triage_level]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>triage_level</remote-alias>
            <ordinal>11</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>procedure_name</remote-name>
            <remote-type>129</remote-type>
            <local-name>[procedure_name]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>procedure_name</remote-alias>
            <ordinal>23</ordinal>
            <local-type>string</local-type>
            <aggregation>Count</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>net_amount</remote-name>
            <remote-type>5</remote-type>
            <local-name>[net_amount]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>net_amount</remote-alias>
            <ordinal>31</ordinal>
            <local-type>real</local-type>
            <aggregation>Sum</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
          <metadata-record class='column'>
            <remote-name>length_of_stay</remote-name>
            <remote-type>20</remote-type>
            <local-name>[length_of_stay]</local-name>
            <parent-name>[hospital_clinical_master#csv]</parent-name>
            <remote-alias>length_of_stay</remote-alias>
            <ordinal>8</ordinal>
            <local-type>integer</local-type>
            <aggregation>Avg</aggregation>
            <contains-null>true</contains-null>
          </metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Billing ID' datatype='integer' name='[billing_id]' role='dimension' type='ordinal' />
      <column caption='Admission Date' datatype='date' name='[admission_date]' role='dimension' type='ordinal' />
      <column caption='Department' datatype='string' name='[department_name]' role='dimension' type='nominal' />
      <column caption='Triage Level' datatype='string' name='[triage_level]' role='dimension' type='nominal' />
      <column caption='Procedure' datatype='string' name='[procedure_name]' role='dimension' type='nominal' />
      <column caption='Length of Stay (Days)' datatype='integer' name='[length_of_stay]' role='measure' type='quantitative' />
      <column caption='Net Clinical Billing (INR)' datatype='real' default-format='C16393' name='[net_amount]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
    </datasource>
  </datasources>

  <worksheets>
    <!-- Worksheet 1: Monthly Admissions Billing Trend -->
    <worksheet name='Monthly_Admissions_Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='PulseCare_Hospital_Clinical_Data' name='federated.hospital_data' />
          </datasources>
          <datasource-dependencies datasource='federated.hospital_data'>
            <column datatype='date' name='[admission_date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[net_amount]' role='measure' type='quantitative' />
            <column-instance column='[admission_date]' derivation='Month-Trunc' name='[tmn:admission_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[net_amount]' derivation='Sum' name='[sum:net_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane id='1' selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Area' />
            <encodings>
              <color column='[federated.hospital_data].[sum:net_amount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.hospital_data].[sum:net_amount:qk]</rows>
        <cols>[federated.hospital_data].[tmn:admission_date:qk]</cols>
      </table>
      <simple-id uuid='{B1A1B2C3-D4E5-4678-9012-3456789ABC01}' />
    </worksheet>

    <!-- Worksheet 2: Department Bed Occupancy & Billing -->
    <worksheet name='Department_Bed_Occupancy'>
      <table>
        <view>
          <datasources>
            <datasource caption='PulseCare_Hospital_Clinical_Data' name='federated.hospital_data' />
          </datasources>
          <datasource-dependencies datasource='federated.hospital_data'>
            <column datatype='string' name='[department_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[net_amount]' role='measure' type='quantitative' />
            <column-instance column='[department_name]' derivation='None' name='[none:department_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[net_amount]' derivation='Sum' name='[sum:net_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.hospital_data].[sum:net_amount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.hospital_data].[none:department_name:nk]</rows>
        <cols>[federated.hospital_data].[sum:net_amount:qk]</cols>
      </table>
      <simple-id uuid='{B1A1B2C3-D4E5-4678-9012-3456789ABC02}' />
    </worksheet>

    <!-- Worksheet 3: Triage Level Distribution -->
    <worksheet name='Triage_Level_Distribution'>
      <table>
        <view>
          <datasources>
            <datasource caption='PulseCare_Hospital_Clinical_Data' name='federated.hospital_data' />
          </datasources>
          <datasource-dependencies datasource='federated.hospital_data'>
            <column datatype='string' name='[triage_level]' role='dimension' type='nominal' />
            <column datatype='real' name='[net_amount]' role='measure' type='quantitative' />
            <column-instance column='[triage_level]' derivation='None' name='[none:triage_level:nk]' pivot='key' type='nominal' />
            <column-instance column='[net_amount]' derivation='Sum' name='[sum:net_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Pie' />
            <encodings>
              <color column='[federated.hospital_data].[none:triage_level:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.hospital_data].[sum:net_amount:qk]</rows>
        <cols>[federated.hospital_data].[none:triage_level:nk]</cols>
      </table>
      <simple-id uuid='{B1A1B2C3-D4E5-4678-9012-3456789ABC03}' />
    </worksheet>

    <!-- Worksheet 4: Top Clinical Procedures -->
    <worksheet name='Top_Clinical_Procedures'>
      <table>
        <view>
          <datasources>
            <datasource caption='PulseCare_Hospital_Clinical_Data' name='federated.hospital_data' />
          </datasources>
          <datasource-dependencies datasource='federated.hospital_data'>
            <column datatype='string' name='[procedure_name]' role='dimension' type='nominal' />
            <column datatype='real' name='[net_amount]' role='measure' type='quantitative' />
            <column-instance column='[procedure_name]' derivation='None' name='[none:procedure_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[net_amount]' derivation='Sum' name='[sum:net_amount:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.hospital_data].[sum:net_amount:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.hospital_data].[none:procedure_name:nk]</rows>
        <cols>[federated.hospital_data].[sum:net_amount:qk]</cols>
      </table>
      <simple-id uuid='{B1A1B2C3-D4E5-4678-9012-3456789ABC04}' />
    </worksheet>
  </worksheets>

  <dashboards>
    <dashboard name='PulseCare_Clinical_Operations_Dashboard'>
      <style />
      <size maxheight='850' maxwidth='1280' minheight='850' minwidth='1280' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='5' param='horz' type-v2='layout-flow' w='98000' x='1000' y='1000'>
            <zone h='98000' id='6' param='vert' type-v2='layout-flow' w='49000' x='1000' y='1000'>
              <zone h='49000' id='7' name='Monthly_Admissions_Trend' type-v2='widget' w='49000' x='1000' y='1000' />
              <zone h='49000' id='8' name='Triage_Level_Distribution' type-v2='widget' w='49000' x='1000' y='50000' />
